# Copy to `%APPDATA%\crew-tui\.env` (Windows) or `~/.config/crew-tui/.env` (Linux) and fill in.
# Everything is optional; roles degrade gracefully.
# ── Cloud API (OpenAI-compatible) ─────────────────────────────────────────
# Required for: fieldmarshal, architect, fast_cloud and the beam-free fallback.
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
# last = subscription models only as a last resort (default); primary = old
# behaviour; off = never call them (ignore the key entirely).
OPENCODE_MODE=last

# ── Gemini (native, large-context + multimodal) ───────────────────────────
GEMINI_API_KEY=

# ── Direct DeepSeek API (pay-as-you-go) ───────────────────────────────────
# Optional. When set, the architect/chief uses DeepSeek off-peak and Gemini
# during the peak windows below (protects the pay-as-you-go bill).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
PEAK_POLICY=1
PEAK_WINDOWS_UTC=01:00-04:00,06:00-10:00
PEAK_WEEKDAYS_ONLY=1

# ── Senior dev / fixer ("stealth" free model first) ───────────────────────
# big-pickle is listed on the free zen endpoint but is often 429 for API
# clients; the pool probes once and falls back to Gemini when unavailable.
SENIOR_MODEL=big-pickle
SENIOR_BASE_URL=https://opencode.ai/zen/v1
SENIOR_PROBE=1
# Set to 1 to pin big-pickle as primary even if the probe fails (429s will
# then burn one failed call per task before the Gemini fallback kicks in).
SENIOR_FORCE=0

# ── Local llama.cpp worker (auto-detected; fallback = beam-free) ──────────
# Port/model are detected per machine. Override if yours differ.
LOCAL_LLM_URL=http://127.0.0.1:8081/v1
LOCAL_MODEL_NAME=qwen3.6-35b-a3b
# Optional: command to start the local server on demand.
# Linux:  LOCAL_START_CMD=systemctl --user start qwen36
# Windows: LOCAL_START_CMD=powershell -Command "Start-Process -FilePath 'path\to\llama-server.exe' -ArgumentList '--port 8081' -WindowStyle Hidden"
# Service stopped/started around an off-peak suspend (empty = keep running).
LOCAL_SERVICE=qwen36
QWEN_RESTART_ON_WAKE=1

# ── Power: keep awake + off-peak sleep (Linux/systemd) ────────────────────
# Hold an idle inhibitor while agents work (GNOME won't suspend mid-run).
KEEP_AWAKE=1
# 1 = at peak, pause the run, arm the RTC alarm and suspend; resume off-peak.
# Requires scripts/crew-sleep (install once with sudo) and DEEPSEEK_API_KEY.
SLEEP_OFFPEAK=0
# Only suspend after the session has been idle this long (minutes).
OFFPEAK_IDLE_MIN=5
# 1 = suspend even if you are typing (same effect as --unattended).
SLEEP_IF_ACTIVE=0
SLEEP_HELPER=/usr/local/sbin/crew-sleep

# The same four variables apply on Windows, where the backend keeps the PC awake
# and pauses at peak but does NOT suspend (it waits awake until off-peak):
#   KEEP_AWAKE, SLEEP_OFFPEAK, OFFPEAK_IDLE_MIN, SLEEP_IF_ACTIVE

# ── Cloud model mapping (per role) ────────────────────────────────────────
FIELD_MARSHAL_MODEL=deepseek-v4-pro
FALLBACK_MODEL=kimi-k3.1-pro
ARCHITECT_MODEL=kimi-k3.1-pro
FAST_CLOUD_MODEL=deepseek-v4.1-flash
GEMINI_MODEL=gemini-3.5-flash
BEAM_FREE_MODEL=beam-free

# ── Reasoning / thinking (per role: 1=on, 0=off) ──────────────────────────
REASONING_EFFORT=medium
THINK_FIELDMARSHAL=1
THINK_ARCHITECT=1
THINK_FAST_CLOUD=0
THINK_WORKER=0
THINK_CRITIC=0
THINK_GEMINI=True
# Secondary Gemini model when the primary is rate-limited ("too busy").
GEMINI_FALLBACK_MODEL=gemini-3.8-flash

# ── Context protection (OOM safeguard) ────────────────────────────────────
LOCAL_SAFE_TOKENS=18000
LARGE_CONTEXT_TOKENS=32000

# ── Verification ──────────────────────────────────────────────────────────
WORKSPACE_DIR=workspace
MAX_VERIFY_LOOPS=3

# ── Telemetry / portability ───────────────────────────────────────────────
LOG_DIR=logs
LOG_MAX_BYTES=10000000
SPEC_DIR=specs

# ── Project context ("trabalha na pasta X") ───────────────────────────────
# Default folder to read as context if you don't type a path in the input.
PROJECT_DIR=~/projetos_opencode
SCAN_MAX_FILES=150
SCAN_MAX_CHARS_PER_FILE=12000
SCAN_TOTAL_CHARS=80000

STREAM_MODE=progress
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_MAX_OUTPUT_TOKENS=8192
LOCAL_TASK_TOKENS=1500
LOCAL_SUMMARIZE_CHARS=20000
TEST_ORACLE=True
HARD_TASK_TOKENS=800
